# Copiá este archivo como .env.local y completá los valores. NUNCA subas .env.local a git.
# En Vercel: Settings → Environment Variables (las mismas claves).

# --- Base de datos (Neon) ---
DATABASE_URL="postgresql://usuario:clave@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# --- Sesiones (better-auth) ---
# Generala con:  npx @better-auth/cli secret   (o cualquier string aleatorio de 32+ caracteres)
BETTER_AUTH_SECRET=""
# En tu PC: http://localhost:3000. En Vercel ponés la URL de producción (o la dejás vacía y se calcula sola).
BETTER_AUTH_URL="http://localhost:3000"
# URL pública que va en los links de los mails (ej. https://plan-b.vercel.app).
APP_URL="http://localhost:3000"

# --- Superadmin (equipo de Plan B) ---
# Emails habilitados como superadmin, separados por coma. Entran por la URL interna de la plataforma
# ("Primer ingreso" les manda un link de un solo uso para definir la contraseña).
SUPERADMIN_EMAILS="lorviz@ucaecemdp.edu.ar"
# Quiénes reciben el aviso de "Nueva solicitud de alta" (si se deja vacío, se usa SUPERADMIN_EMAILS).
SUPERADMIN_NOTIFY_EMAILS="lorviz@ucaecemdp.edu.ar"

# --- Mails ---
# smtp = envío real con Gmail / Google Workspace (contraseña de aplicación).
# Cualquier otro valor (o vacío) = solo se guardan en email_outbox (visibles en la plataforma → Mails).
MAIL_PROVIDER="smtp"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="lorviz@ucaecemdp.edu.ar"
# Contraseña de APLICACIÓN de Google (16 caracteres), no la contraseña normal de la cuenta.
SMTP_PASS=""
MAIL_FROM="Plan B <lorviz@ucaecemdp.edu.ar>"

# --- Cron de vencimientos ---
# Vercel la manda como "Authorization: Bearer <CRON_SECRET>" al llamar /api/cron/vencimientos.
CRON_SECRET=""
# Días de gracia entre el vencimiento y la pausa automática (opcional, default 7).
PAUSE_AFTER_DAYS="7"

# --- Datos de demo ---
# true = en cada build carga 4 locales y 4 eventos de ejemplo con fechas próximas (idempotente).
SEED_DEMO="true"

# --- Contacto comercial (botón "Quiero sumar mi local" de la landing) ---
# Si hay email se usa mailto:, si no, WhatsApp. Son públicos (se ven en el navegador).
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_CONTACT_WHATSAPP=""
